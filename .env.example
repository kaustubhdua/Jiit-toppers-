# PostgreSQL connection string. Keep real credentials in local .env.local or the deployment secret store.
# Never commit credentials or expose database URLs through NEXT_PUBLIC_* variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jiit_toppers?schema=public"

# Supabase Auth for server-rendered cookie sessions.
# Use the project URL and publishable key from Supabase project settings.
# The publishable key is safe for browser use only when paired with correct RLS/server authorization.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
