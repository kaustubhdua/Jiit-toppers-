generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataTrust {
  OFFICIAL
  VERIFIED
  COMMUNITY
  DEMO
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum ResourceType {
  NOTE
  PYQ
  ASSIGNMENT
  TUTORIAL
  LAB
  BOOK
  VIDEO
  CHEAT_SHEET
  OTHER
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum ExamType {
  T1
  T2
  T3
  MIDTERM
  END_SEM
  QUIZ
  LAB
  OTHER
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AcademicRecordSource {
  MANUAL
  CSV_IMPORT
  XLSX_IMPORT
  PDF_IMPORT
  AUTHORIZED_PORTAL
}

enum AcademicImportKind {
  GRADE_CARD
  ATTENDANCE
  TIMETABLE
  EXAM_SCHEDULE
}

enum AcademicImportStatus {
  REVIEW_REQUIRED
  CONFIRMED
  FAILED
  DELETED
}

model User {
  id             String   @id @default(cuid())
  authProviderId String?  @unique
  email          String   @unique
  name           String?
  role           UserRole @default(STUDENT)
  campusId       String?
  branchId       String?
  admissionYear  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campus             Campus?                @relation(fields: [campusId], references: [id], onDelete: SetNull)
  branch             Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  resources          Resource[]             @relation("ResourceUploader")
  reviewedResources  Resource[]             @relation("ResourceReviewer")
  placementExperiences PlacementExperience[]
  discussions        Discussion[]
  discussionReplies  DiscussionReply[]
  auditEvents        AuditEvent[]           @relation("AuditActor")

  @@index([campusId, branchId, admissionYear])
  @@index([role])
  @@index([branchId])
}


model AcademicTerm {
  id             String   @id @default(cuid())
  userId         String
  label          String
  academicYear   Int
  semesterNumber Int
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects            StudentSubject[]
  gradeRecords        GradeRecord[]
  attendanceSnapshots AttendanceSnapshot[]
  imports             AcademicImport[]

  @@unique([userId, academicYear, semesterNumber])
  @@index([userId, academicYear])
}

model StudentSubject {
  id        String   @id @default(cuid())
  userId    String
  termId    String
  code      String
  name      String
  credits   Decimal  @db.Decimal(4, 1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  term                AcademicTerm         @relation(fields: [termId], references: [id], onDelete: Cascade)
  grades              GradeRecord[]
  attendanceSnapshots AttendanceSnapshot[]

  @@unique([termId, code])
  @@index([userId, termId])
}

model AcademicImport {
  id             String              @id @default(cuid())
  userId         String
  termId         String?
  kind           AcademicImportKind
  status         AcademicImportStatus @default(REVIEW_REQUIRED)
  originalName   String
  mimeType       String
  sizeBytes      BigInt
  checksum       String?
  storageKey     String?
  parserVersion  String?
  sourceLabel    String?
  errorSummary   String?
  createdAt      DateTime            @default(now())
  confirmedAt    DateTime?
  deletedAt      DateTime?

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  term                AcademicTerm?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  gradeRecords        GradeRecord[]
  attendanceSnapshots AttendanceSnapshot[]

  @@unique([userId, checksum])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model GradeRecord {
  id              String               @id @default(cuid())
  userId          String
  termId          String
  studentSubjectId String
  gradePoint      Decimal              @db.Decimal(4, 2)
  letterGrade     String?
  marksObtained   Decimal?             @db.Decimal(6, 2)
  maxMarks        Decimal?             @db.Decimal(6, 2)
  source          AcademicRecordSource @default(MANUAL)
  sourceLabel     String?
  observedAt      DateTime             @default(now())
  importId        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  term    AcademicTerm   @relation(fields: [termId], references: [id], onDelete: Cascade)
  subject StudentSubject @relation(fields: [studentSubjectId], references: [id], onDelete: Cascade)
  import  AcademicImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([userId, termId, studentSubjectId])
  @@index([userId, termId, observedAt])
  @@index([importId])
}

model AttendanceSnapshot {
  id               String               @id @default(cuid())
  userId           String
  termId           String
  studentSubjectId String
  classesHeld      Int
  classesAttended  Int
  targetPercent    Decimal              @default(75) @db.Decimal(5, 2)
  source           AcademicRecordSource @default(MANUAL)
  sourceLabel      String?
  observedAt       DateTime             @default(now())
  importId         String?
  createdAt        DateTime             @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  term    AcademicTerm   @relation(fields: [termId], references: [id], onDelete: Cascade)
  subject StudentSubject @relation(fields: [studentSubjectId], references: [id], onDelete: Cascade)
  import  AcademicImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([userId, termId, observedAt])
  @@index([studentSubjectId, observedAt])
  @@index([importId])
}

model Campus {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  resources     Resource[]
  announcements Announcement[]
  events        CampusEvent[]
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  curricula   Curriculum[]
}

model Curriculum {
  id             String   @id @default(cuid())
  name           String
  admissionYear  Int
  programme      String   @default("B.Tech")
  branchId       String
  version        String
  sourceUrl      String?
  sourceCheckedAt DateTime?
  trust          DataTrust @default(COMMUNITY)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  subjects CurriculumSubject[]

  @@unique([branchId, admissionYear, version])
  @@index([admissionYear, branchId])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  credits     Decimal? @db.Decimal(4, 1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  curriculumLinks CurriculumSubject[]
  resources       Resource[]
  exams           Exam[]

  @@index([code])
  @@index([name])
}

model CurriculumSubject {
  id           String @id @default(cuid())
  curriculumId String
  subjectId    String
  semester     Int
  isElective   Boolean @default(false)

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([curriculumId, subjectId])
  @@index([curriculumId, semester])
  @@index([subjectId])
}

model Resource {
  id             String         @id @default(cuid())
  title          String
  description    String?
  type           ResourceType
  status         ResourceStatus @default(PENDING)
  trust          DataTrust      @default(COMMUNITY)
  sourceUrl      String?
  storageKey     String?
  originalName   String?
  mimeType       String?
  sizeBytes      BigInt?
  academicYear   Int?
  examType       ExamType?
  subjectId      String?
  campusId       String?
  uploaderId     String?
  reviewerId     String?
  reviewedAt     DateTime?
  rejectionNote  String?
  sourceCheckedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  subject  Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  campus   Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  uploader User?    @relation("ResourceUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  reviewer User?    @relation("ResourceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([subjectId, type, status])
  @@index([trust, status])
  @@index([campusId, createdAt])
  @@index([uploaderId, createdAt])
  @@index([reviewerId])
}

model Exam {
  id             String   @id @default(cuid())
  title          String
  type           ExamType
  startsAt       DateTime?
  endsAt         DateTime?
  room           String?
  syllabus       String?
  sourceUrl      String?
  sourceCheckedAt DateTime?
  trust          DataTrust @default(COMMUNITY)
  subjectId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([startsAt, type])
  @@index([subjectId, startsAt])
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  websiteUrl  String?
  description String?
  sourceUrl   String?
  sourceCheckedAt DateTime?
  trust       DataTrust @default(COMMUNITY)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  experiences PlacementExperience[]
}

model PlacementExperience {
  id          String   @id @default(cuid())
  companyId   String
  authorId    String?
  title       String
  content     String
  trust       DataTrust @default(COMMUNITY)
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId, isApproved, createdAt])
  @@index([authorId])
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  content        String
  sourceUrl      String?
  sourceCheckedAt DateTime?
  trust          DataTrust @default(OFFICIAL)
  status         AnnouncementStatus @default(DRAFT)
  publishedAt    DateTime?
  campusId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([campusId, publishedAt])
}

model CampusEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  venue       String?
  sourceUrl   String?
  trust       DataTrust @default(COMMUNITY)
  campusId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([campusId, startsAt])
}

model Discussion {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String?
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  replies DiscussionReply[]

  @@index([isHidden, createdAt])
  @@index([authorId])
}

model DiscussionReply {
  id           String   @id @default(cuid())
  discussionId String
  authorId     String?
  body         String
  isHidden     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author     User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([discussionId, isHidden, createdAt])
  @@index([authorId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
